# Environment variables for the R&T Brand/Supplier Qualifier.
#
# This project shares the same .env as the rest of the course repo (see the
# repo root's setup instructions) - it does not need a separate .env file.
# This example only documents the variables THIS project actually reads.

# Required. Used for all agent calls (Brand and Supplier Qualifier alike)
# and for the hosted WebSearchTool (no separate search API key needed -
# see README.md's "Research provider" note on why Tavily/OpenRouter were
# deliberately not introduced).
OPENAI_API_KEY=sk-...

# Optional. Overrides the default model used by every agent in this project.
# DEFAULT_MODEL_NAME=gpt-5.4-mini

# Supplier Qualifier cost/scope controls are CLI flags, not env vars - see
# --concurrency, --limit, and config.SUPPLIER_MAX_ESCALATIONS_PER_BRAND in
# README.md.
