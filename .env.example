# Environment variables for the R&T Brand/Supplier Qualifier.
# Copy this file to .env and fill in the values.

# Required. Used for all agent calls (Brand and Supplier Qualifier alike)
# and for the hosted WebSearchTool (no separate search API key needed -
# see README.md's "Research provider" note on why Tavily/OpenRouter were
# deliberately not introduced).
OPENAI_API_KEY=sk-...

# Optional. Overrides the default model used by every agent in this project.
# DEFAULT_MODEL_NAME=gpt-5.4-mini

# Supplier Qualifier cost/scope controls are CLI flags, not env vars - see
# --concurrency, --limit, and config.SUPPLIER_MAX_ESCALATIONS_PER_BRAND in
# README.md.

# Optional, but recommended once more than one app shares your OpenAI org -
# scopes check_openai_cost.py's spend report to just this project instead of
# every app on the org. This is the "proj_..." id OPENAI_API_KEY above
# belongs to (platform.openai.com -> Settings -> Projects).
# OPENAI_PROJECT_ID=proj_...

# Optional - only needed to run check_openai_cost.py. An Admin API key (NOT
# the regular OPENAI_API_KEY above, which can't read billing data). Create
# one at platform.openai.com -> Settings -> Organization -> Admin keys
# (needs the api.usage.read scope, org owner/admin role required).
# OPENAI_ADMIN_KEY=sk-admin-...
